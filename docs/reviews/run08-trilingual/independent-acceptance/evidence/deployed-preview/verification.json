        {
          "id": "plan-cbd-1:p5",
          "title": "Conflict analysis and baseline",
          "source": {
            "kind": "official-plan-teaching-excerpt-paraphrase",
            "label": "UNPOL CBD Job-Specific Training Lesson 1; 2021 curriculum / July2023 supplied file",
