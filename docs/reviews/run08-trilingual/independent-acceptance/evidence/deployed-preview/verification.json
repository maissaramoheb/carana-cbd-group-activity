            "digitalFiles": [
              {
                "file": "course/visual-journey.js",
                "sha256": "b6096911d16853c758c4561fa4425cfe152def698c164fe423b0f40b7d2d78ec"
              },
              {
                "file": "course/lesson1-experience.js",
                "sha256": "d7cad01df1f4702bb4129200d567d99affa7257bc3cd5fcf5ab6dc406d2326df"
              },
              {
                "file": "course/lesson1-illustrations.js",
                "sha256": "72dc03ef2c592a5c10daa808f047641dedcbd4309529ebd844940537a72048de"
              }
