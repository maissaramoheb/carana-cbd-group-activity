{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/quick-exercise",
      "destination": "/CARANA_CBD_Group_Activity"
    },
    {
      "source": "/module1",
      "destination": "/module1"
    },
    {
      "source": "/module2",
      "destination": "/module2"
    },
    {
      "source": "/module3",
      "destination": "/module3"
    },
    {
      "source": "/module4",
      "destination": "/module4"
    },
    {
      "source": "/module5",
      "destination": "/module5"
    },
    {
      "source": "/module6",
      "destination": "/module6"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/course/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/course/audio/en/lesson1/:asset",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
